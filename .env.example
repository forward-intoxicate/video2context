# 复制成 .env 并填入你自己的值。.env 已在 .gitignore 中，不会被提交。
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# 大模型密钥（只用于「自动推断领域词表」，不配置也能用其他全部功能）
# DeepSeek: https://platform.deepseek.com  →  API keys
V2C_LLM_API_KEY=sk-在这里填你的密钥

# 服务地址（OpenAI 兼容协议即可）
#   DeepSeek   : https://api.deepseek.com
#   OpenAI     : https://api.openai.com/v1
#   本地 Ollama: http://127.0.0.1:11434/v1
V2C_LLM_BASE_URL=https://api.deepseek.com

# 模型名
#   DeepSeek   : deepseek-chat
#   本地 Ollama: qwen2.5:7b
V2C_LLM_MODEL=deepseek-chat

# 可选：单次请求超时（秒）
V2C_LLM_TIMEOUT=120


# ---------------------------------------------------------------------------
# 默认识别引擎（可选）
#
#   qwen3-asr       （首选）中文同音词/数学符号明显更准、英文 WER 更低，
#                   需要独立环境（scripts/setup_qwen.ps1 / setup_qwen.sh）与约 4GB 显存
#   faster-whisper  轻量、不需要 torch，CPU 也能跑，还支持 --task translate
#
# 不配置时程序会**按本机实际装了哪个引擎自动决定**：
#   只装了 Whisper → 用 Whisper；只装了 Qwen → 用 Qwen；两个都装 → 优先 Qwen。
# 所以这行通常不用改，只在想强制固定成某个引擎时才取消注释。
# V2C_ENGINE=faster-whisper

# 可选：Qwen3-ASR 独立环境的解释器路径。
# 默认自动找工程内的 .venv-qwen；装在别处时才需要这一行。
# V2C_QWEN_PYTHON=D:\envs\qwen\Scripts\python.exe
