# 复制成 .env 并填入你自己的值。.env 已在 .gitignore 中，不会被提交。
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# 大模型密钥（只用于「自动推断领域词表」，不配置也能用其他全部功能）
# DeepSeek: https://platform.deepseek.com  →  API keys
V2C_LLM_API_KEY=sk-在这里填你的密钥

# 服务地址（OpenAI 兼容协议即可）
#   DeepSeek   : https://api.deepseek.com
#   OpenAI     : https://api.openai.com/v1
#   本地 Ollama: http://127.0.0.1:11434/v1
V2C_LLM_BASE_URL=https://api.deepseek.com

# 模型名
#   DeepSeek   : deepseek-chat
#   本地 Ollama: qwen2.5:7b
V2C_LLM_MODEL=deepseek-chat

# 可选：单次请求超时（秒）
V2C_LLM_TIMEOUT=120


# ---------------------------------------------------------------------------
# 默认识别引擎（可选）
#
#   faster-whisper  默认值：轻量、不需要 torch，CPU 也能跑
#   qwen3-asr       中文同音词/数学符号明显更准、英文 WER 更低，
#                   但需要先装独立环境（scripts/setup_qwen.ps1 / setup_qwen.sh）
#                   以及约 4GB 显存
#
# 不配置就是 faster-whisper。想在自己机器上默认用 Qwen 就取消下面这行的注释。
# 命令行 --engine 的优先级更高，随时可以临时切换。
# V2C_ENGINE=qwen3-asr

# 可选：Qwen3-ASR 独立环境的解释器路径。
# 默认自动找工程内的 .venv-qwen；装在别处时才需要这一行。
# V2C_QWEN_PYTHON=D:\envs\qwen\Scripts\python.exe
